+TextureCache::Texture* TextureCache::FindOrCreateTextureMemo(TextureBindingMemoEntry* memo,
+                                                             const TextureKey& key,
+                                                             bool signed_version) {
+  TextureKey lookup_key = key;
+  if (signed_version) {
+    lookup_key.signed_separate = 1;
+  }
+  if (!memo) {
+    return FindOrCreateTexture(lookup_key);
+  }
+  uint8_t looked_up_bit = signed_version ? 0b10 : 0b01;
+  Texture*& memo_texture = signed_version ? memo->texture_signed : memo->texture;
+  if (memo->looked_up & looked_up_bit) {
+    if (REXCVAR_GET(gpu_draw_state_cache_validate)) {
+      Texture* texture = FindOrCreateTexture(lookup_key);
+      if (texture != memo_texture) {
+        if (texture_binding_memo_mismatches_++ < 16) {
+          REXGPU_WARN("gpu_texture_binding_cache mismatch: texture {} instead of {}",
+                      static_cast<void*>(memo_texture), static_cast<void*>(texture));
+        }
+        return texture;
+      }
+    }
+    return memo_texture;
+  }
+  Texture* texture = FindOrCreateTexture(lookup_key);
+  // A failed creation isn't remembered, so it's retried like without the memo.
+  if (texture) {
+    memo_texture = texture;
+    memo->looked_up |= looked_up_bit;
+  }
+  return texture;
+}
