+bool D3D12CommandProcessor::InitializeGpuTimestampResources() {
+  using Profile = GpuTimestampProfile;
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  constexpr uint32_t kQueryCount = Profile::kBlockSize * Profile::kBlockCount;
+  UINT64 frequency = 0;
+  if (!device || FAILED(provider.GetDirectQueue()->GetTimestampFrequency(&frequency)) ||
+      !frequency) {
+    REXGPU_WARN("d3d12_gpu_timestamp_buckets: GPU timestamps are not available on this queue");
+    return false;
+  }
+  auto profile = std::make_unique<Profile>();
+  D3D12_QUERY_HEAP_DESC heap_desc;
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kQueryCount;
+  heap_desc.NodeMask = 0;
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&profile->query_heap)))) {
+    REXGPU_WARN("d3d12_gpu_timestamp_buckets: Failed to create the timestamp query heap");
+    return false;
+  }
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kQueryCount,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  void* mapping = nullptr;
+  D3D12_RANGE read_range = {0, sizeof(uint64_t) * kQueryCount};
+  if (FAILED(device->CreateCommittedResource(
+          &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+          &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+          IID_PPV_ARGS(&profile->readback))) ||
+      FAILED(profile->readback->Map(0, &read_range, &mapping))) {
+    REXGPU_WARN("d3d12_gpu_timestamp_buckets: Failed to create the timestamp readback buffer");
+    return false;
+  }
+  profile->readback_mapping = reinterpret_cast<const uint64_t*>(mapping);
+  profile->frequency = frequency;
+  profile->free_blocks.reserve(Profile::kBlockCount);
+  for (uint32_t i = Profile::kBlockCount; i-- > 0;) {
+    profile->free_blocks.push_back(i);
+  }
+  gpu_timestamp_profile_ = std::move(profile);
+  REXGPU_INFO("d3d12_gpu_timestamp_buckets: GPU timestamps enabled ({} Hz)", frequency);
+  return true;
+}
+
+void D3D12CommandProcessor::ShutdownGpuTimestampResources() {
+  gpu_profile::g_gpu_enabled.store(false, std::memory_order_relaxed);
+  if (gpu_timestamp_profile_ && gpu_timestamp_profile_->readback_mapping) {
+    gpu_timestamp_profile_->readback->Unmap(0, nullptr);
+  }
+  gpu_timestamp_profile_.reset();
+}
+
+void D3D12CommandProcessor::BeginGpuTimestampSubmission() {
+  GpuTimestampProfile* profile = gpu_timestamp_profile_.get();
+  if (profile) {
+    profile->current_block = UINT32_MAX;
+  }
+  if (!REXCVAR_GET(d3d12_gpu_timestamp_buckets)) {
+    if (gpu_profile::g_gpu_enabled.load(std::memory_order_relaxed)) {
+      gpu_profile::g_gpu_enabled.store(false, std::memory_order_relaxed);
+    }
+    return;
+  }
+  if (!profile) {
+    if (gpu_timestamp_profile_failed_) {
+      return;
+    }
+    if (!InitializeGpuTimestampResources()) {
+      gpu_timestamp_profile_failed_ = true;
+      return;
+    }
+    profile = gpu_timestamp_profile_.get();
+  }
+  gpu_profile::g_gpu_enabled.store(true, std::memory_order_relaxed);
+  if (profile->free_blocks.empty()) {
+    gpu_profile::AddGpuValue(gpu_profile::GpuValue::kSkippedSubmissions, 1);
+    return;
+  }
+  uint32_t block_index = profile->free_blocks.back();
+  profile->free_blocks.pop_back();
+  GpuTimestampProfile::Block& block = profile->blocks[block_index];
+  block.submission = 0;
+  block.frame = 0;
+  block.query_count = 2;
+  block.open_bucket_query = UINT32_MAX;
+  block.bucket_count = 0;
+  deferred_command_list_.D3DEndQuery(profile->query_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     block_index * GpuTimestampProfile::kBlockSize);
+  profile->current_block = block_index;
+}
+
+void D3D12CommandProcessor::EndGpuTimestampSubmission() {
+  GpuTimestampProfile* profile = gpu_timestamp_profile_.get();
+  if (!profile || profile->current_block == UINT32_MAX) {
+    return;
+  }
+  uint32_t block_index = profile->current_block;
+  profile->current_block = UINT32_MAX;
+  GpuTimestampProfile::Block& block = profile->blocks[block_index];
+  ID3D12QueryHeap* query_heap = profile->query_heap.Get();
+  const uint32_t query_base = block_index * GpuTimestampProfile::kBlockSize;
+  if (block.open_bucket_query != UINT32_MAX) {
+    // A bucket still open at the end of the submission is dropped, but its
+    // end query is written so that every resolved query has been issued.
+    deferred_command_list_.D3DEndQuery(query_heap, D3D12_QUERY_TYPE_TIMESTAMP,
+                                       query_base + block.open_bucket_query + 1);
+    block.open_bucket_query = UINT32_MAX;
+  }
+  deferred_command_list_.D3DEndQuery(query_heap, D3D12_QUERY_TYPE_TIMESTAMP, query_base + 1);
+  deferred_command_list_.D3DResolveQueryData(query_heap, D3D12_QUERY_TYPE_TIMESTAMP, query_base,
+                                             block.query_count, profile->readback.Get(),
+                                             sizeof(uint64_t) * query_base);
+  // The fence value this submission signals.
+  block.submission = submission_current_;
+  block.frame = frame_current_;
+  profile->pending_blocks.push_back(block_index);
+}
+
+uint32_t D3D12CommandProcessor::BeginGpuTimestampBucket() {
+  GpuTimestampProfile* profile = gpu_timestamp_profile_.get();
+  if (!profile || profile->current_block == UINT32_MAX) {
+    return UINT32_MAX;
+  }
+  uint32_t block_index = profile->current_block;
+  GpuTimestampProfile::Block& block = profile->blocks[block_index];
+  if (block.open_bucket_query != UINT32_MAX ||
+      block.query_count + 2 > GpuTimestampProfile::kBlockSize) {
+    return UINT32_MAX;
+  }
+  uint32_t query = block.query_count;
+  block.query_count += 2;
+  block.open_bucket_query = query;
+  deferred_command_list_.D3DEndQuery(profile->query_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     block_index * GpuTimestampProfile::kBlockSize + query);
+  return (block_index << 16) | query;
+}
+
+void D3D12CommandProcessor::EndGpuTimestampBucket(uint32_t token, GpuTimestampBucket kind) {
+  GpuTimestampProfile* profile = gpu_timestamp_profile_.get();
+  if (token == UINT32_MAX || !profile) {
+    return;
+  }
+  uint32_t block_index = token >> 16;
+  uint32_t query = token & 0xFFFF;
+  // Dropped if its submission has ended in the meantime.
+  if (block_index != profile->current_block) {
+    return;
+  }
+  GpuTimestampProfile::Block& block = profile->blocks[block_index];
+  if (block.open_bucket_query != query) {
+    return;
+  }
+  deferred_command_list_.D3DEndQuery(profile->query_heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     block_index * GpuTimestampProfile::kBlockSize + query + 1);
+  block.open_bucket_query = UINT32_MAX;
+  block.buckets[block.bucket_count++] = {kind, query};
+}
+
+void D3D12CommandProcessor::ProcessGpuTimestampResults() {
+  GpuTimestampProfile* profile = gpu_timestamp_profile_.get();
+  if (!profile) {
+    return;
+  }
+  while (!profile->pending_blocks.empty()) {
+    uint32_t block_index = profile->pending_blocks.front();
+    const GpuTimestampProfile::Block& block = profile->blocks[block_index];
+    if (block.submission > submission_completed_) {
+      break;
+    }
+    profile->pending_blocks.pop_front();
+    GpuTimestampProfile::FrameTotals& totals = profile->frame_totals;
+    if (block.frame != totals.frame) {
+      FinishGpuTimestampFrame();
+      totals = {};
+      totals.frame = block.frame;
+    }
+    const uint64_t* timestamps =
+        profile->readback_mapping + size_t(block_index) * GpuTimestampProfile::kBlockSize;
+    uint64_t start = timestamps[0];
+    uint64_t end = timestamps[1];
+    if (end > start) {
+      if (!totals.submissions || start < totals.first_start) {
+        totals.first_start = start;
+      }
+      totals.last_end = std::max(totals.last_end, end);
+      totals.busy += end - start;
+      ++totals.submissions;
+      for (uint32_t i = 0; i < block.bucket_count; ++i) {
+        uint64_t bucket_start = timestamps[block.buckets[i].start_query];
+        uint64_t bucket_end = timestamps[block.buckets[i].start_query + 1];
+        if (bucket_end <= bucket_start) {
+          continue;
+        }
+        if (block.buckets[i].kind == GpuTimestampBucket::kResolve) {
+          totals.resolve += bucket_end - bucket_start;
+          ++totals.resolves;
+        } else {
+          totals.swap += bucket_end - bucket_start;
+        }
+      }
+    }
+    profile->free_blocks.push_back(block_index);
+  }
+}
+
+void D3D12CommandProcessor::FinishGpuTimestampFrame() {
+  const GpuTimestampProfile* profile = gpu_timestamp_profile_.get();
+  if (!profile) {
+    return;
+  }
+  const GpuTimestampProfile::FrameTotals& totals = profile->frame_totals;
+  if (totals.frame == UINT64_MAX || !totals.submissions || !profile->frequency) {
+    return;
+  }
+  const double us_per_tick = 1000000.0 / double(profile->frequency);
+  auto to_us = [us_per_tick](uint64_t ticks) { return uint64_t(double(ticks) * us_per_tick + 0.5); };
+  using gpu_profile::GpuValue;
+  gpu_profile::AddGpuValue(GpuValue::kFrames, 1);
+  gpu_profile::AddGpuValue(GpuValue::kSubmissions, totals.submissions);
+  gpu_profile::AddGpuValue(GpuValue::kBusyUs, to_us(totals.busy));
+  gpu_profile::AddGpuValue(GpuValue::kSpanUs, to_us(totals.last_end - totals.first_start));
+  gpu_profile::AddGpuValue(GpuValue::kResolveUs, to_us(totals.resolve));
+  gpu_profile::AddGpuValue(GpuValue::kResolves, totals.resolves);
+  gpu_profile::AddGpuValue(GpuValue::kSwapUs, to_us(totals.swap));
+}
