index 0000000..9571277
--- /dev/null
+++ b/include/rex/graphics/gpu_profile.h
@@ -0,0 +1,198 @@
+/**
+ * @file        graphics/gpu_profile.h
+ * @brief       Runtime-armed frame attribution for the GPU emulation
+ *
+ * Based on the CPU profile (gpu_cpu_profile) and the D3D12 GPU timestamp
+ * buckets (d3d12_gpu_timestamp_buckets) of the rexglue-skate3 fork of the
+ * ReXGlue SDK (commits 9dd4138 and 4ae4da7), Copyright (c) 2026, Tom Clay,
+ * reduced to a self-contained set of stages for this runtime. Distributed
+ * under the BSD 3-Clause License included with the ReXGlue license notice.
+ */
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+
+#if defined(_M_X64) || defined(__x86_64__)
+#if defined(_MSC_VER) || defined(_WIN32)
+#include <intrin.h>
+#else
+#include <x86intrin.h>
+#endif
+#define REX_GPU_PROFILE_RDTSC 1
+#endif
+
+namespace rex::graphics::gpu_profile {
+
+// Accumulated per stage while gpu_cpu_profile is enabled. Times are raw ticks
+// (see Ticks()), counts are numbers of scopes, except for value stages.
+// Each stage is written by a single thread: the GPU command thread, or for
+// kAsync* the D3D12 submission thread. Stages only nest as documented in the
+// command processor's profile log.
+enum class Stage : uint32_t {
+  // Command thread, top level.
+  kCommandBusy,  // Executing primary ring buffer commands.
+  kCommandIdle,  // Waiting for the guest to write more commands.
+  kGuestWait,    // WAIT_REG_MEM waits for guest memory or registers.
+  // Draws (IssueDraw, excluding EDRAM copies). The sub-stages are laps.
+  kDraw,
+  kDrawBegin,         // BeginSubmission, including waits for queued frames.
+  kDrawPrimitive,     // Primitive (index buffer) processing.
+  kDrawRenderTarget,  // Render target cache update (may record transfers).
+  kDrawPipeline,      // Shader translation lookup and pipeline configuration.
+  kDrawTexture,       // Texture cache requests (may load textures).
+  kDrawState,         // Viewport, constants, descriptors and root bindings.
+  kDrawVertexBuffer,  // Vertex and memexport buffers in shared memory.
+  kDrawRecord,        // Topology, index buffer, barriers and the draw itself.
+  kDrawMemexport,     // Memexport invalidation and readback.
+  kDrawSubmit,        // Mid-frame submission (d3d12_submit_draw_interval).
+  kCopy,              // EDRAM resolves (IssueCopy).
+  kSwap,              // Frame end (IssueSwap), including the frame submission.
+  // Submission on the command thread (all EndSubmission calls).
+  kSubmit,
+  kSubmitRecord,      // Synchronous: replay and ExecuteCommandLists.
+                      // Asynchronous: handing the commands to the thread.
+  kSubmitThreadWait,  // Waiting for the submission thread at frame end.
+  kFenceWait,         // Waiting for the GPU to complete submissions.
+  kPresentSync,       // Present idle-clean synchronization wait.
+  // D3D12 submission thread (d3d12_async_submission).
+  kAsyncReplay,   // Replaying recorded commands into the command list.
+  kAsyncExecute,  // ExecuteCommandLists and Signal.
+  // Values (ticks hold the value).
+  kUploadBytes,  // Guest memory uploaded to the GPU shared memory buffer.
+  kCount
+};
+
+struct Slot {
+  std::atomic<uint64_t> ticks{0};
+  std::atomic<uint64_t> count{0};
+};
+
+inline std::atomic<bool> g_enabled{false};
+inline Slot g_slots[size_t(Stage::kCount)];
+
+// GPU timestamp results (d3d12_gpu_timestamp_buckets), in microseconds,
+// accumulated per completed guest frame by the backend.
+enum class GpuValue : uint32_t {
+  kFrames,       // Guest frames with timestamp results.
+  kSubmissions,  // Command lists measured.
+  kBusyUs,       // Sum of command list execution times.
+  kSpanUs,       // First command list start to last command list end.
+  kResolveUs,    // EDRAM resolves.
+  kResolves,
+  kSwapUs,  // Frame end work (gamma and post effects before presenting).
+  kSkippedSubmissions,  // Not measured because no query block was free.
+  kCount
+};
+inline std::atomic<bool> g_gpu_enabled{false};
+inline std::atomic<uint64_t> g_gpu_values[size_t(GpuValue::kCount)];
+
+inline void AddGpuValue(GpuValue value, uint64_t amount) {
+  g_gpu_values[size_t(value)].fetch_add(amount, std::memory_order_relaxed);
+}
+
+inline bool Enabled() { return g_enabled.load(std::memory_order_relaxed); }
+
+inline uint64_t Ticks() {
+#ifdef REX_GPU_PROFILE_RDTSC
+  return __rdtsc();
+#else
+  return uint64_t(std::chrono::steady_clock::now().time_since_epoch().count());
+#endif
+}
+
+// Single-writer accumulation without a locked read-modify-write.
+inline void Add(Stage stage, uint64_t ticks, uint64_t count = 1) {
+  Slot& slot = g_slots[size_t(stage)];
+  slot.ticks.store(slot.ticks.load(std::memory_order_relaxed) + ticks, std::memory_order_relaxed);
+  slot.count.store(slot.count.load(std::memory_order_relaxed) + count, std::memory_order_relaxed);
+}
+
+inline void AddValue(Stage stage, uint64_t value) {
+  if (Enabled()) {
+    Add(stage, value);
+  }
+}
+
+// Times a whole scope. Costs one relaxed load and a branch when disabled.
+class Scope {
+ public:
+  explicit Scope(Stage stage) : stage_(stage), active_(Enabled()) {
+    if (active_) {
+      start_ = Ticks();
+    }
+  }
+  ~Scope() {
+    if (active_) {
+      Add(stage_, Ticks() - start_);
+    }
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+
+ private:
+  Stage stage_;
+  bool active_;
+  uint64_t start_ = 0;
+};
+
+// Splits a scope into consecutive stages with one timestamp per boundary:
+// Mark(stage) attributes the time since the previous mark to stage.
+class Laps {
+ public:
+  Laps() : active_(Enabled()) {
+    if (active_) {
+      last_ = Ticks();
+    }
+  }
+  void Mark(Stage stage) {
+    if (active_) {
+      uint64_t now = Ticks();
+      Add(stage, now - last_);
+      last_ = now;
+    }
+  }
+  bool active() const { return active_; }
+
+ private:
+  bool active_;
+  uint64_t last_ = 0;
+};
+
+// Compile-time variant of Scope plus Laps for per-draw code, which is
+// instantiated twice and selected by one Enabled() check: the scope's whole
+// time goes to `total`, the laps to their stages. Without kActive it does
+// nothing, so the unprofiled path has no profiling code at all.
+template <bool kActive>
+class ScopeLaps {
+ public:
+  explicit ScopeLaps(Stage total) : total_(total) {
+    if constexpr (kActive) {
+      start_ = Ticks();
+      last_ = start_;
+    }
+  }
+  ~ScopeLaps() {
+    if constexpr (kActive) {
+      Add(total_, Ticks() - start_);
+    }
+  }
+  ScopeLaps(const ScopeLaps&) = delete;
+  ScopeLaps& operator=(const ScopeLaps&) = delete;
+  void Mark(Stage stage) {
+    if constexpr (kActive) {
+      uint64_t now = Ticks();
+      Add(stage, now - last_);
+      last_ = now;
+    }
+  }
+
+ private:
+  Stage total_;
+  uint64_t start_ = 0;
+  uint64_t last_ = 0;
+};
+
+}  // namespace rex::graphics::gpu_profile
