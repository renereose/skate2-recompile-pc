+// Reporting window of gpu_cpu_profile and d3d12_gpu_timestamp_buckets. Only
+// used on the command thread. The stage accumulators are never reset (some are
+// written by other threads); each window logs the difference to a snapshot.
+constexpr uint32_t kGpuProfileLogFrameInterval = 120;
+struct GpuProfileWindow {
+  bool active = false;
+  uint32_t frames = 0;
+  uint64_t start_ticks = 0;
+  std::chrono::steady_clock::time_point start_time;
+  uint64_t ticks[size_t(gpu_profile::Stage::kCount)] = {};
+  uint64_t counts[size_t(gpu_profile::Stage::kCount)] = {};
+  uint64_t gpu_values[size_t(gpu_profile::GpuValue::kCount)] = {};
+};
+GpuProfileWindow g_gpu_profile_window;
+
+void StartGpuProfileWindow(GpuProfileWindow& window, uint64_t now_ticks,
+                           std::chrono::steady_clock::time_point now_time) {
+  for (size_t i = 0; i < size_t(gpu_profile::Stage::kCount); ++i) {
+    window.ticks[i] = gpu_profile::g_slots[i].ticks.load(std::memory_order_relaxed);
+    window.counts[i] = gpu_profile::g_slots[i].count.load(std::memory_order_relaxed);
+  }
+  for (size_t i = 0; i < size_t(gpu_profile::GpuValue::kCount); ++i) {
+    window.gpu_values[i] = gpu_profile::g_gpu_values[i].load(std::memory_order_relaxed);
+  }
+  window.frames = 0;
+  window.start_ticks = now_ticks;
+  window.start_time = now_time;
+  window.active = true;
+}
+
+void LogGpuProfileWindow(const GpuProfileWindow& window, uint64_t now_ticks,
+                         std::chrono::steady_clock::time_point now_time, bool cpu_profile) {
+  using gpu_profile::GpuValue;
+  using gpu_profile::Stage;
+  const double frames = double(window.frames);
+  const double window_us = double(
+      std::chrono::duration_cast<std::chrono::microseconds>(now_time - window.start_time).count());
+  const uint64_t window_ticks = now_ticks - window.start_ticks;
+  if (window_us <= 0.0 || !window_ticks || frames <= 0.0) {
+    return;
+  }
+  // Scope timestamps are raw ticks; calibrate them against the wall clock of
+  // the whole window.
+  const double us_per_tick = window_us / double(window_ticks);
+  const double frame_us = window_us / frames;
+  auto ticks = [&](Stage stage) {
+    return gpu_profile::g_slots[size_t(stage)].ticks.load(std::memory_order_relaxed) -
+           window.ticks[size_t(stage)];
+  };
+  auto us = [&](Stage stage) -> uint64_t {
+    return uint64_t(double(ticks(stage)) * us_per_tick / frames + 0.5);
+  };
+  auto per_frame = [&](Stage stage) -> double {
+    return double(gpu_profile::g_slots[size_t(stage)].count.load(std::memory_order_relaxed) -
+                  window.counts[size_t(stage)]) /
+           frames;
+  };
+  auto gpu_value = [&](GpuValue value) {
+    return gpu_profile::g_gpu_values[size_t(value)].load(std::memory_order_relaxed) -
+           window.gpu_values[size_t(value)];
+  };
+
+  const uint64_t gpu_frames = gpu_value(GpuValue::kFrames);
+  const double gpu_busy_us =
+      gpu_frames ? double(gpu_value(GpuValue::kBusyUs)) / double(gpu_frames) : 0.0;
+
+  if (cpu_profile) {
+    const uint64_t busy = us(Stage::kCommandBusy);
+    const uint64_t idle = us(Stage::kCommandIdle);
+    const uint64_t guest_wait = us(Stage::kGuestWait);
+    const uint64_t fence_wait = us(Stage::kFenceWait);
+    const uint64_t present_sync = us(Stage::kPresentSync);
+    const uint64_t thread_wait = us(Stage::kSubmitThreadWait);
+    const uint64_t waits = guest_wait + fence_wait + present_sync + thread_wait;
+    const uint64_t work = busy > waits ? busy - waits : 0;
+    const uint64_t async_busy = us(Stage::kAsyncReplay) + us(Stage::kAsyncExecute);
+    const uint64_t submit_record = us(Stage::kSubmitRecord);
+
+    // A first hint at the limiting side; the stage values are the evidence.
+    const char* limit = "mixed";
+    if (gpu_frames && gpu_busy_us >= 0.85 * frame_us) {
+      limit = "gpu";
+    } else if (double(async_busy) >= 0.85 * frame_us || double(thread_wait) >= 0.2 * frame_us) {
+      limit = "submission_thread";
+    } else if (double(fence_wait + present_sync) >= 0.2 * frame_us) {
+      limit = "gpu_wait";
+    } else if (double(work) >= 0.75 * frame_us) {
+      limit = double(submit_record) >= 0.3 * double(work) ? "command_thread_submission"
+                                                          : "command_thread";
+    } else if (double(idle + guest_wait) >= 0.25 * frame_us) {
+      limit = "guest";
+    }
+    REXGPU_INFO(
+        "GPU profile (avg per frame over {} frames, us): frame={:.0f} fps={:.1f} limit={} | "
+        "command thread: busy={} work={} idle={} guest_wait={} fence_wait={} ({:.1f}x) "
+        "present_sync={} submit_thread_wait={}",
+        window.frames, frame_us, 1000000.0 / frame_us, limit, busy, work, idle, guest_wait,
+        fence_wait, per_frame(Stage::kFenceWait), present_sync, thread_wait);
+
+    const uint64_t draw = us(Stage::kDraw);
+    const Stage draw_stages[] = {Stage::kDrawBegin,        Stage::kDrawPrimitive,
+                                 Stage::kDrawRenderTarget, Stage::kDrawPipeline,
+                                 Stage::kDrawTexture,      Stage::kDrawState,
+                                 Stage::kDrawVertexBuffer, Stage::kDrawRecord,
+                                 Stage::kDrawMemexport,    Stage::kDrawSubmit};
+    uint64_t draw_staged_ticks = 0;
+    for (Stage stage : draw_stages) {
+      draw_staged_ticks += ticks(stage);
+    }
+    const uint64_t draw_ticks = ticks(Stage::kDraw);
+    const uint64_t draw_other =
+        draw_ticks > draw_staged_ticks
+            ? uint64_t(double(draw_ticks - draw_staged_ticks) * us_per_tick / frames + 0.5)
+            : 0;
+    REXGPU_INFO(
+        "GPU profile stages (avg per frame, us): draws={:.0f}x draw={} [begin={} prim={} rt={} "
+        "pipeline={} tex={} state={} vb={} record={} memexport={} submit={} other={}] "
+        "copies={:.1f}x copy={} swap={} | submissions={:.1f}x submit={} [record={}] | "
+        "upload={:.0f}KiB | submission thread: replay={} execute={}",
+        per_frame(Stage::kDraw), draw, us(Stage::kDrawBegin), us(Stage::kDrawPrimitive),
+        us(Stage::kDrawRenderTarget), us(Stage::kDrawPipeline), us(Stage::kDrawTexture),
+        us(Stage::kDrawState), us(Stage::kDrawVertexBuffer), us(Stage::kDrawRecord),
+        us(Stage::kDrawMemexport), us(Stage::kDrawSubmit), draw_other, per_frame(Stage::kCopy),
+        us(Stage::kCopy), us(Stage::kSwap), per_frame(Stage::kSubmit), us(Stage::kSubmit),
+        submit_record, double(ticks(Stage::kUploadBytes)) / frames / 1024.0,
+        us(Stage::kAsyncReplay), us(Stage::kAsyncExecute));
+  }
+
+  if (gpu_frames) {
+    const double gpu_frames_d = double(gpu_frames);
+    auto gpu_avg = [&](GpuValue value) { return double(gpu_value(value)) / gpu_frames_d; };
+    const double span_us = gpu_avg(GpuValue::kSpanUs);
+    const double resolve_us = gpu_avg(GpuValue::kResolveUs);
+    const double swap_us = gpu_avg(GpuValue::kSwapUs);
+    const double rest_us = std::max(0.0, gpu_busy_us - resolve_us - swap_us);
+    REXGPU_INFO(
+        "GPU profile timestamps (avg per frame over {} frames, us): busy={:.0f} span={:.0f} "
+        "idle_in_span={:.0f} draws_and_other={:.0f} resolve={:.0f} ({:.1f}x) swap={:.0f} "
+        "submissions={:.1f}x utilization={:.0f}% of frame={:.0f} skipped_submissions={}",
+        gpu_frames, gpu_busy_us, span_us, std::max(0.0, span_us - gpu_busy_us), rest_us,
+        resolve_us, gpu_avg(GpuValue::kResolves), swap_us, gpu_avg(GpuValue::kSubmissions),
+        100.0 * gpu_busy_us / frame_us, frame_us, gpu_value(GpuValue::kSkippedSubmissions));
+  }
+}
+
+// Called on the command thread after each guest frame's swap.
+void OnGpuProfileFrameEnd() {
+  const bool cpu_profile = REXCVAR_GET(gpu_cpu_profile);
+  GpuProfileWindow& window = g_gpu_profile_window;
+  if (cpu_profile != gpu_profile::g_enabled.load(std::memory_order_relaxed)) {
+    gpu_profile::g_enabled.store(cpu_profile, std::memory_order_relaxed);
+    if (cpu_profile) {
+      REXGPU_INFO("GPU profile: CPU attribution enabled (gpu_cpu_profile), logging every {} frames",
+                  kGpuProfileLogFrameInterval);
+    }
+    // Restart so a window only covers frames with complete data.
+    window.active = false;
+  }
+  if (!cpu_profile && !gpu_profile::g_gpu_enabled.load(std::memory_order_relaxed)) {
+    window.active = false;
+    return;
+  }
+  const uint64_t now_ticks = gpu_profile::Ticks();
+  const auto now_time = std::chrono::steady_clock::now();
+  if (!window.active) {
+    StartGpuProfileWindow(window, now_ticks, now_time);
+    return;
+  }
+  if (++window.frames < kGpuProfileLogFrameInterval) {
+    return;
+  }
+  LogGpuProfileWindow(window, now_ticks, now_time, cpu_profile);
+  StartGpuProfileWindow(window, now_ticks, now_time);
+}
