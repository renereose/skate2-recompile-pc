+// Condition-variable wait strategy for the timer queue, based on
+// rexglue-skate3 commit f8da2d0 (BSD 3-Clause). The dispatch thread waits until
+// the next timer is due, or until a new timer is queued. disruptorplus's spin
+// strategy polls that wait with thread yields and 1 ms sleeps for its whole
+// length; disruptorplus::blocking_wait_strategy passes the predicate and the
+// timeout to the condition variable in the wrong order, so its timed waits do
+// not compile. This is that strategy with the standard argument order, kept
+// here so the third-party header stays unmodified.
+class BlockingWaitStrategy {
+ public:
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[]) {
+    dp::sequence_t result;
+    std::unique_lock<std::mutex> lock(mutex_);
+    condition_.wait(lock, [&]() {
+      result = dp::minimum_sequence_after(sequence, count, sequences);
+      return dp::difference(result, sequence) >= 0;
+    });
+    return result;
+  }
+
+  template <typename Rep, typename Period>
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[],
+                                      const std::chrono::duration<Rep, Period>& timeout) {
+    dp::sequence_t result;
+    std::unique_lock<std::mutex> lock(mutex_);
+    condition_.wait_for(lock, timeout, [&]() {
+      result = dp::minimum_sequence_after(sequence, count, sequences);
+      return dp::difference(result, sequence) >= 0;
+    });
+    return result;
+  }
+
+  template <typename Clock, typename Duration>
+  dp::sequence_t wait_until_published(dp::sequence_t sequence, size_t count,
+                                      const std::atomic<dp::sequence_t>* const sequences[],
+                                      const std::chrono::time_point<Clock, Duration>& timeout_time) {
+    dp::sequence_t result;
+    std::unique_lock<std::mutex> lock(mutex_);
+    condition_.wait_until(lock, timeout_time, [&]() {
+      result = dp::minimum_sequence_after(sequence, count, sequences);
+      return dp::difference(result, sequence) >= 0;
+    });
+    return result;
+  }
+
+  void signal_all_when_blocking() {
+    // Under the lock, so a waiter between checking the sequences and blocking
+    // can't miss the notification.
+    std::lock_guard<std::mutex> lock(mutex_);
+    condition_.notify_all();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::condition_variable condition_;
+};
