+void D3D12CommandProcessor::LogPresentIdleclean() {
+  auto& log = present_idleclean_log_;
+  const int32_t interval = REXCVAR_GET(d3d12_present_idleclean_log);
+  if (interval <= 0 || !log.first_frame) {
+    // Start a fresh window, also when the log is turned on while running.
+    log = {};
+    log.first_frame = frame_current_;
+    return;
+  }
+  const uint64_t frames = frame_current_ - log.first_frame;
+  if (frames < uint64_t(interval)) {
+    return;
+  }
+  const double per_frame = 1.0 / double(frames);
+  REXGPU_INFO(
+      "Idle-clean waits (avg per frame over {} frames): {:.2f} waits, {:.2f} blocked, {:.0f} us "
+      "waited (longest {} us), {:.2f} closed frames still on the GPU when waiting, "
+      "d3d12_present_idleclean_sync_lag {} ({:.2f} waits for an older frame)",
+      frames, double(log.synchronized) * per_frame, double(log.blocked) * per_frame,
+      double(log.waited_us) * per_frame, log.max_waited_us,
+      log.synchronized ? double(log.frames_in_flight) / double(log.synchronized) : 0.0,
+      REXCVAR_GET(d3d12_present_idleclean_sync_lag), double(log.lagged) * per_frame);
+  log = {};
+  log.first_frame = frame_current_;
+}
