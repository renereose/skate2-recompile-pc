+bool SharedMemory::IsRangeValidAndAllocatedUnlocked(uint32_t start, uint32_t length) const {
+  uint32_t page_first = start >> page_size_log2_;
+  uint32_t page_last = (start + length - 1) >> page_size_log2_;
+  if (host_gpu_memory_sparse_granularity_log2_ != UINT32_MAX) {
+    // Same allocation range as EnsureHostGpuMemoryAllocated.
+    uint32_t allocation_first =
+        page_first << page_size_log2_ >> host_gpu_memory_sparse_granularity_log2_;
+    uint32_t allocation_last =
+        page_last << page_size_log2_ >> host_gpu_memory_sparse_granularity_log2_;
+    const uint64_t* allocated = host_gpu_memory_sparse_allocated_.data();
+    for (uint32_t i = allocation_first; i <= allocation_last; ++i) {
+      if (!(allocated[i >> 6] & (uint64_t(1) << (i & 63)))) {
+        return false;
+      }
+    }
+  }
+  uint32_t block_first = page_first >> 6;
+  uint32_t block_last = page_last >> 6;
+  uint64_t* valid = const_cast<uint64_t*>(system_page_flags_valid_.data());
+  for (uint32_t i = block_first; i <= block_last; ++i) {
+    uint64_t needed = UINT64_MAX;
+    if (i == block_first) {
+      needed &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (i == block_last && (page_last & 63) != 63) {
+      needed &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    uint64_t block_valid = std::atomic_ref<uint64_t>(valid[i]).load(std::memory_order_acquire);
+    if ((block_valid & needed) != needed) {
+      return false;
+    }
+  }
+  return true;
+}
