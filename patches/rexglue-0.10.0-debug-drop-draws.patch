+// d3d12_debug_drop_draws counters, logged every kLogInterval while the probe
+// is active. Only touched on the command processor thread.
+struct D3D12CommandProcessor::DebugDropDrawsStats {
+  static constexpr auto kLogInterval = std::chrono::seconds(5);
+  static constexpr uint32_t kMaxPitches = 16;
+  struct Pitch {
+    uint32_t pitch;
+    uint32_t dropped;
+    uint32_t executed;
+  };
+  std::chrono::steady_clock::time_point start = std::chrono::steady_clock::now();
+  uint32_t frames = 0;
+  uint64_t dropped_draws = 0;
+  uint64_t executed_draws = 0;
+  uint64_t memexport_draws = 0;
+  uint64_t dropped_resolves = 0;
+  uint64_t executed_resolves = 0;
+  uint64_t fake_queries = 0;
+  uint32_t pitch_count = 0;
+  uint32_t other_pitches = 0;
+  Pitch pitches[kMaxPitches];
+
+  void CountPitch(uint32_t pitch, bool dropped) {
+    for (uint32_t i = 0; i < pitch_count; ++i) {
+      if (pitches[i].pitch == pitch) {
+        ++(dropped ? pitches[i].dropped : pitches[i].executed);
+        return;
+      }
+    }
+    if (pitch_count < kMaxPitches) {
+      pitches[pitch_count++] = {pitch, dropped ? 1u : 0u, dropped ? 0u : 1u};
+    } else {
+      ++other_pitches;
+    }
+  }
+};
