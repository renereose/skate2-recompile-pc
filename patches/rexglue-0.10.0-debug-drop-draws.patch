+std::atomic<uint8_t> g_debug_drop_draws_request{0};
+
+uint8_t ParseDebugDropDraws(std::string_view value) {
+  if (value == "all") {
+    return 2;
+  }
+  if (value == "fullscreen") {
+    return 1;
+  }
+  return 0;
+}
+
+const char* DebugDropDrawsName(uint8_t mode) {
+  switch (mode) {
+    case 1:
+      return "fullscreen";
+    case 2:
+      return "all";
+    default:
+      return "off";
+  }
+}
