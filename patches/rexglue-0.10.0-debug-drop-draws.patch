+void D3D12CommandProcessor::LatchDebugDropDraws() {
+  const auto requested =
+      DebugDropDraws(g_debug_drop_draws_request.load(std::memory_order_relaxed));
+  DebugDropDrawsStats* stats = debug_drop_draws_stats_.get();
+  if (requested != debug_drop_draws_) {
+    REXGPU_INFO("d3d12_debug_drop_draws: {} -> {} (fullscreen = surfaces from {} pixels wide)",
+                DebugDropDrawsName(uint8_t(debug_drop_draws_)), DebugDropDrawsName(uint8_t(requested)),
+                REXCVAR_GET(d3d12_debug_drop_draws_min_pitch));
+    debug_drop_draws_ = requested;
+    if (requested != DebugDropDraws::kOff) {
+      if (!stats) {
+        debug_drop_draws_stats_ = std::make_unique<DebugDropDrawsStats>();
+      } else {
+        *stats = DebugDropDrawsStats();
+      }
+    }
+    return;
+  }
+  if (debug_drop_draws_ == DebugDropDraws::kOff || !stats) {
+    return;
+  }
+  ++stats->frames;
+  if (std::chrono::steady_clock::now() - stats->start < DebugDropDrawsStats::kLogInterval) {
+    return;
+  }
+  const double frames = double(stats->frames);
+  std::string surfaces;
+  for (uint32_t i = 0; i < stats->pitch_count; ++i) {
+    const DebugDropDrawsStats::Pitch& pitch = stats->pitches[i];
+    surfaces += fmt::format("{}{}: {:.0f}/{:.0f}", i ? ", " : "", pitch.pitch,
+                            double(pitch.dropped) / frames, double(pitch.executed) / frames);
+  }
+  if (stats->other_pitches) {
+    surfaces += fmt::format(", other widths: {:.0f}", double(stats->other_pitches) / frames);
+  }
+  REXGPU_INFO(
+      "d3d12_debug_drop_draws={}: per frame {:.0f} draws dropped, {:.0f} executed ({:.0f} memory "
+      "export), resolves {:.1f} dropped / {:.1f} executed, {:.1f} fake query results; draws by "
+      "surface width, dropped/executed: {}",
+      DebugDropDrawsName(uint8_t(debug_drop_draws_)), double(stats->dropped_draws) / frames,
+      double(stats->executed_draws + stats->memexport_draws) / frames,
+      double(stats->memexport_draws) / frames, double(stats->dropped_resolves) / frames,
+      double(stats->executed_resolves) / frames, double(stats->fake_queries) / frames, surfaces);
+  *stats = DebugDropDrawsStats();
+}
+
+bool D3D12CommandProcessor::DebugDropDraw() {
+  const RegisterFile& regs = *register_file_;
+  DebugDropDrawsStats& stats = *debug_drop_draws_stats_;
+  const uint32_t pitch = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  const bool pass_dropped =
+      debug_drop_draws_ == DebugDropDraws::kAll ||
+      pitch >= uint32_t(REXCVAR_GET(d3d12_debug_drop_draws_min_pitch));
+  const xenos::EdramMode edram_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if (edram_mode == xenos::EdramMode::kCopy) {
+    // A resolve of a dropped pass would copy stale EDRAM contents.
+    ++(pass_dropped ? stats.dropped_resolves : stats.executed_resolves);
+    return pass_dropped;
+  }
+  if (!pass_dropped) {
+    ++stats.executed_draws;
+    stats.CountPitch(pitch, false);
+    return false;
+  }
+  // Memory export writes guest memory that the game may read back, so those
+  // draws still run. Shader analysis is cached in the shader.
+  auto* vertex_shader = static_cast<D3D12Shader*>(active_vertex_shader());
+  if (!vertex_shader) {
+    return false;
+  }
+  pipeline_cache_->AnalyzeShaderUcode(*vertex_shader);
+  bool memexport = vertex_shader->memexport_eM_written() != 0;
+  if (!memexport && edram_mode == xenos::EdramMode::kColorDepth) {
+    auto* pixel_shader = static_cast<D3D12Shader*>(active_pixel_shader());
+    if (pixel_shader) {
+      pipeline_cache_->AnalyzeShaderUcode(*pixel_shader);
+      memexport = pixel_shader->memexport_eM_written() != 0;
+    }
+  }
+  if (memexport) {
+    ++stats.memexport_draws;
+    stats.CountPitch(pitch, false);
+    return false;
+  }
+  ++stats.dropped_draws;
+  stats.CountPitch(pitch, true);
+  return true;
+}
