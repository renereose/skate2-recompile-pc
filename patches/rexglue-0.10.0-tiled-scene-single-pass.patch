+bool D3D12CommandProcessor::TiledSceneRenderTargetsHoldRows(uint32_t bottom) const {
+  if (!render_target_cache_ ||
+      render_target_cache_->GetPath() != RenderTargetCache::Path::kHostRenderTargets) {
+    return false;
+  }
+  auto rb_surface_info = register_file_->Get<reg::RB_SURFACE_INFO>();
+  if (!rb_surface_info.surface_pitch) {
+    return false;
+  }
+  return render_target_cache_->GetHostRenderTargetHeightForSurface(
+             rb_surface_info.surface_pitch, rb_surface_info.msaa_samples) >= bottom;
+}
+
+bool D3D12CommandProcessor::TiledSceneCanRenderTall(uint32_t full_bottom) const {
+  return TiledSceneRenderTargetsHoldRows(full_bottom);
