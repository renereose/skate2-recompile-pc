+bool D3D12RenderTargetCache::TiledScenePrepareRowsBelowFirstTile(uint32_t from_row,
+                                                                 uint32_t to_row) {
+  if (GetPath() != Path::kHostRenderTargets || to_row <= from_row) {
+    return false;
+  }
+  uint32_t bracket = command_processor_.tiled_scene_bracket_id();
+  if (tiled_scene_prepared_bracket_ != bracket) {
+    tiled_scene_prepared_bracket_ = bracket;
+    tiled_scene_prepared_depth_ = nullptr;
+    tiled_scene_prepared_color_ = nullptr;
+  }
+  uint32_t bound = GetLastUpdateBoundRenderTargets();
+  // Only depth and color 0 are cleared by the first tile's resolve for the
+  // later tiles.
+  if (bound & ~uint32_t(0b11)) {
+    return false;
+  }
+  RenderTarget* const* render_targets = last_update_accumulated_render_targets();
+  RenderTarget* depth = (bound & 0b01) ? render_targets[0] : nullptr;
+  RenderTarget* color = (bound & 0b10) ? render_targets[1] : nullptr;
+  RenderTarget* clear_render_targets[2] = {};
+  if (depth && depth != tiled_scene_prepared_depth_) {
+    if (tiled_scene_prepared_depth_) {
+      // A different depth buffer within the scene.
+      return false;
+    }
+    clear_render_targets[0] = depth;
+  }
+  if (color && color != tiled_scene_prepared_color_) {
+    if (tiled_scene_prepared_color_) {
+      return false;
+    }
+    xenos::ColorRenderTargetFormat color_format = color->key().GetColorFormat();
+    if (color_format == xenos::ColorRenderTargetFormat::k_32_FLOAT ||
+        color_format == xenos::ColorRenderTargetFormat::k_32_32_FLOAT) {
+      // May need clearing by drawing, which would change the bindings.
+      return false;
+    }
+    clear_render_targets[1] = color;
+  }
+  if (!clear_render_targets[0] && !clear_render_targets[1]) {
+    return true;
+  }
+  RenderTargetKey key = (clear_render_targets[0] ? clear_render_targets[0] : clear_render_targets[1])
+                            ->key();
+  if (clear_render_targets[0] && clear_render_targets[1]) {
+    RenderTargetKey color_key = clear_render_targets[1]->key();
+    if (color_key.pitch_tiles_at_32bpp != key.pitch_tiles_at_32bpp ||
+        color_key.msaa_samples != key.msaa_samples) {
+      return false;
+    }
+  }
+  if (to_row > GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples)) {
+    return false;
+  }
+  Transfer::Rectangle clear_rectangle;
+  clear_rectangle.x_pixels = 0;
+  clear_rectangle.y_pixels = from_row;
+  clear_rectangle.width_pixels =
+      key.pitch_tiles_at_32bpp *
+      (xenos::kEdramTileWidthSamples >> uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X));
+  clear_rectangle.height_pixels = to_row - from_row;
+  const RegisterFile& regs = register_file();
+  uint64_t clear_values[2];
+  clear_values[0] = regs[XE_GPU_REG_RB_DEPTH_CLEAR];
+  clear_values[1] =
+      regs[XE_GPU_REG_RB_COLOR_CLEAR] | (uint64_t(regs[XE_GPU_REG_RB_COLOR_CLEAR_LO]) << 32);
+  PerformTransfersAndResolveClears(2, clear_render_targets, tiled_scene_no_transfers_,
+                                   clear_values, &clear_rectangle);
+  if (clear_render_targets[0]) {
+    tiled_scene_prepared_depth_ = clear_render_targets[0];
+  }
+  if (clear_render_targets[1]) {
+    tiled_scene_prepared_color_ = clear_render_targets[1];
+  }
+  command_processor_.TiledScenePreCleared(clear_render_targets[0] != nullptr,
+                                          uint32_t(clear_values[0]),
+                                          clear_render_targets[1] != nullptr, clear_values[1]);
+  return true;
+}
