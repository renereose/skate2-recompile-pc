+void CommandProcessor::TiledSceneOnBinSelect() {
+  constexpr uint32_t kFirstTileBit = 0x80000000u;
+  uint32_t select = uint32_t(bin_select_);
+  // The high half is written separately - only react to changes of the low
+  // half, which holds the bins.
+  if (select == tiled_scene_last_select_) {
+    return;
+  }
+  tiled_scene_last_select_ = select;
+  if (select == 0xFFFFFFFFu || !select) {
+    if (tiled_scene_.in_bracket) {
+      TiledSceneEndBracket();
+    }
+    return;
+  }
+  if (select & kFirstTileBit) {
+    if (tiled_scene_.in_bracket) {
+      TiledSceneEndBracket();
+    }
+    TiledSceneState& state = tiled_scene_;
+    state = TiledSceneState();
+    ++tiled_scene_bracket_id_;
+    state.in_bracket = true;
+    state.in_first_tile = true;
+    state.enabled = REXCVAR_GET(gpu_tiled_scene_single_pass);
+    state.first_tile_bins = select & ~kFirstTileBit;
+    ++tiled_scene_stats_.brackets;
+    return;
+  }
+  TiledSceneState& state = tiled_scene_;
+  if (!state.in_bracket) {
+    return;
+  }
+  if (state.in_first_tile) {
+    // Leaving the first tile - decide whether the later tiles can be skipped.
+    state.in_first_tile = false;
+    if (state.enabled && !state.geometry_checked) {
+      TiledSceneCheckGeometry();
+    }
+    if (state.enabled && state.geometry_valid) {
+      if (!state.first_tile_extended) {
+        state.fallback_reason |= 1u << 4;
+      }
+      if (state.first_tile_not_extended) {
+        state.fallback_reason |= 1u << 5;
+      }
+      // The pre-cleared rows must start the later tiles as the first tile's
+      // resolves leave the EDRAM for them - cleared with the same values.
+      if ((state.precleared_color && !(state.first_tile_resolve_clears & 1)) ||
+          (state.precleared_depth && !(state.first_tile_resolve_clears & 2)) ||
+          (!state.precleared_color && !state.precleared_depth)) {
+        state.fallback_reason |= 1u << 6;
+      }
+      if (state.first_tile_resolve_clear_mismatch) {
+        state.fallback_reason |= 1u << 7;
+      }
+      state.skipping = !state.fallback_reason;
+      if (state.skipping) {
+        ++tiled_scene_stats_.single_pass_brackets;
+        tiled_scene_stats_.last_full_bottom = state.full_bottom;
+        tiled_scene_stats_.last_first_tile_bottom = state.first_tile_bottom;
+      }
+    }
+    tiled_scene_stats_.fallback_reasons |= state.fallback_reason;
+  }
+  state.later_tile_bins = select;
+  state.current_tile = nullptr;
+  for (uint32_t i = 0; i < state.tile_count; ++i) {
+    if (state.tiles[i].bins == select) {
+      state.current_tile = &state.tiles[i];
+      break;
+    }
+  }
+}
+
+void CommandProcessor::TiledSceneEndBracket() {
+  tiled_scene_.in_bracket = false;
+  tiled_scene_.in_first_tile = false;
+  tiled_scene_.skipping = false;
+  tiled_scene_.current_tile = nullptr;
+}
+
+void CommandProcessor::TiledSceneCaptureConstant(memory::RingBuffer* reader, uint32_t count) {
+  TiledSceneState& state = tiled_scene_;
+  // Type 4 (registers) from PA_SC_WINDOW_OFFSET: the window offset, scissor
+  // top-left and bottom-right of one tile, predicated with the tile's bins.
+  if (count < 4 || state.geometry_checked) {
+    return;
+  }
+  size_t offset = reader->read_offset();
+  uint32_t offset_type = reader->ReadAndSwap<uint32_t>();
+  if (offset_type != ((4u << 16) | (XE_GPU_REG_PA_SC_WINDOW_OFFSET - 0x2000))) {
+    reader->set_read_offset(offset);
+    return;
+  }
+  uint32_t window_offset = reader->ReadAndSwap<uint32_t>();
+  uint32_t scissor_tl = reader->ReadAndSwap<uint32_t>();
+  uint32_t scissor_br = reader->ReadAndSwap<uint32_t>();
+  reader->set_read_offset(offset);
+  uint32_t bins = uint32_t(bin_mask_);
+  for (uint32_t i = 0; i < state.tile_count; ++i) {
+    if (state.tiles[i].bins == bins) {
+      return;
+    }
+  }
+  if (state.tile_count >= kTiledSceneMaxTiles) {
+    state.fallback_reason |= 1u << 0;
+    return;
+  }
+  auto sign_extend_15 = [](uint32_t value) -> int32_t {
+    value &= 0x7FFF;
+    return (value & 0x4000) ? int32_t(value) - 0x8000 : int32_t(value);
+  };
+  TiledSceneTile& tile = state.tiles[state.tile_count++];
+  tile.bins = bins;
+  tile.window_offset_y = sign_extend_15(window_offset >> 16);
+  // The X offset must be 0 - store it in left as a marker otherwise.
+  int32_t window_offset_x = sign_extend_15(window_offset);
+  tile.left = window_offset_x ? UINT32_MAX : (scissor_tl & 0x7FFF);
+  tile.top = (scissor_tl >> 16) & 0x7FFF;
+  tile.right = scissor_br & 0x7FFF;
+  tile.bottom = (scissor_br >> 16) & 0x7FFF;
+}
+
+void CommandProcessor::TiledSceneCheckGeometry() {
+  TiledSceneState& state = tiled_scene_;
+  state.geometry_checked = true;
+  state.geometry_valid = false;
+  if (state.tile_count < 2) {
+    state.fallback_reason |= 1u << 1;
+    return;
+  }
+  // Tiles stacked vertically from the top, the first one being the first
+  // tile, each one's window offset moving it to the top of the EDRAM.
+  TiledSceneTile sorted[kTiledSceneMaxTiles];
+  std::copy(state.tiles, state.tiles + state.tile_count, sorted);
+  std::sort(sorted, sorted + state.tile_count,
+            [](const TiledSceneTile& a, const TiledSceneTile& b) { return a.top < b.top; });
+  if (sorted[0].bins != state.first_tile_bins || sorted[0].top != 0) {
+    state.fallback_reason |= 1u << 2;
+    return;
+  }
+  uint32_t expected_top = 0;
+  for (uint32_t i = 0; i < state.tile_count; ++i) {
+    const TiledSceneTile& tile = sorted[i];
+    bool tile_valid = tile.left != UINT32_MAX && tile.left == sorted[0].left &&
+                      tile.right == sorted[0].right && tile.top == expected_top &&
+                      tile.bottom > tile.top && tile.window_offset_y == -int32_t(tile.top);
+    if (i) {
+      // Later tiles must have their own bins, not shared with the first tile.
+      tile_valid = tile_valid && tile.bins && !(tile.bins & state.first_tile_bins);
+    }
+    if (!tile_valid) {
+      state.fallback_reason |= 1u << 2;
+      return;
+    }
+    expected_top = tile.bottom;
+  }
+  state.first_tile_bottom = sorted[0].bottom;
+  state.full_bottom = expected_top;
+  if (!TiledSceneCanRenderTall(state.full_bottom)) {
+    state.fallback_reason |= 1u << 3;
+    return;
+  }
+  state.geometry_valid = true;
+}
+
+bool CommandProcessor::TiledSceneBeforeDraw(bool predicated) {
+  TiledSceneState& state = tiled_scene_;
+  if (!state.enabled) {
+    return true;
+  }
+  bool is_copy =
+      register_file_->Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy;
+  auto window_offset = register_file_->Get<reg::PA_SC_WINDOW_OFFSET>();
+  if (state.in_first_tile) {
+    if (window_offset.window_x_offset || window_offset.window_y_offset) {
+      return true;
+    }
+    if (is_copy) {
+      // The resolves at the end of the first tile clear the EDRAM for the next
+      // tile - check that they clear to what the rows below the first tile
+      // were cleared to.
+      uint32_t copy_control = register_file_->values[XE_GPU_REG_RB_COPY_CONTROL];
+      bool clears_color = (copy_control >> 8) & 1;
+      bool clears_depth = (copy_control >> 9) & 1;
+      if (clears_color) {
+        state.first_tile_resolve_clears |= 1;
+        uint64_t color_value =
+            uint64_t(register_file_->values[XE_GPU_REG_RB_COLOR_CLEAR]) |
+            (uint64_t(register_file_->values[XE_GPU_REG_RB_COLOR_CLEAR_LO]) << 32);
+        if ((copy_control & 7) != 0 ||
+            (state.precleared_color && color_value != state.preclear_color_value)) {
+          // Only color render target 0 is pre-cleared.
+          state.first_tile_resolve_clear_mismatch = true;
+        }
+      }
+      if (clears_depth) {
+        state.first_tile_resolve_clears |= 2;
+        if (state.precleared_depth &&
+            register_file_->values[XE_GPU_REG_RB_DEPTH_CLEAR] != state.preclear_depth_value) {
+          state.first_tile_resolve_clear_mismatch = true;
+        }
+      }
+      return true;
+    }
+    if (!state.geometry_checked) {
+      // Only check the geometry once the tile constants have been seen.
+      if (!state.tile_count) {
+        return true;
+      }
+      TiledSceneCheckGeometry();
+    }
+    if (!state.geometry_valid) {
+      return true;
+    }
+    // Draws replayed in the later tiles (predicated with bins of more than the
+    // first tile, or not predicated at all) are extended to the full height.
+    if (predicated && !(uint32_t(bin_mask_) & ~state.first_tile_bins & 0x7FFFFFFFu)) {
+      return true;
+    }
+    tiled_scene_extend_from_ = state.first_tile_bottom;
+    tiled_scene_extend_to_ = state.full_bottom;
+    return true;
+  }
+  if (!state.skipping) {
+    return true;
+  }
+  const TiledSceneTile* tile = state.current_tile;
+  bool in_tile_window =
+      tile && window_offset.window_x_offset == 0 &&
+      int32_t(window_offset.window_y_offset) == tile->window_offset_y;
+  if (is_copy) {
+    // The later tile's rows were rendered below the first tile.
+    if (in_tile_window && tile->top) {
+      tiled_scene_resolve_shift_rows_ = tile->top;
+      ++tiled_scene_stats_.shifted_resolves;
+    }
+    return true;
+  }
+  if (predicated && (uint32_t(bin_mask_) & state.first_tile_bins)) {
+    // A replay of a draw already rendered at the full height in the first
+    // tile.
+    ++tiled_scene_stats_.skipped_draws;
+    return false;
+  }
+  if (in_tile_window) {
+    // Drawn only into this tile's EDRAM rows rather than the rows below the
+    // first tile in the host render targets - counted to see if this happens.
+    ++tiled_scene_stats_.later_tile_kept_draws;
+  }
+  return true;
+}
+
+void CommandProcessor::TiledSceneOnSwap() {
+  TiledSceneStats& stats = tiled_scene_stats_;
+  ++stats.frames;
+  int32_t interval = REXCVAR_GET(gpu_tiled_scene_log);
+  if (interval <= 0 || stats.frames < uint32_t(interval)) {
+    if (interval <= 0) {
+      stats = TiledSceneStats();
+    }
+    return;
+  }
+  double frames = double(stats.frames);
+  REXGPU_INFO(
+      "Tiled scenes (avg per frame over {} frames): {:.2f} tiled scenes, {:.2f} single-pass, "
+      "{:.1f} draws extended from row {} to {}, {:.1f} replayed draws skipped, {:.2f} resolves "
+      "shifted, {:.1f} later-tile draws kept, fallback reasons 0x{:X}, "
+      "gpu_tiled_scene_single_pass {}",
+      stats.frames, stats.brackets / frames, stats.single_pass_brackets / frames,
+      stats.extended_draws / frames, stats.last_first_tile_bottom, stats.last_full_bottom,
+      stats.skipped_draws / frames, stats.shifted_resolves / frames,
+      stats.later_tile_kept_draws / frames, stats.fallback_reasons,
+      REXCVAR_GET(gpu_tiled_scene_single_pass));
+  stats = TiledSceneStats();
+}
