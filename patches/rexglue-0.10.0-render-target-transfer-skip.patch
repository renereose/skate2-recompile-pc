+
+void RenderTargetCache::TransferLogFrame() {
+  transfer_log_this_frame_ = false;
+  transfer_log_draw_ = 0;
+  int32_t interval = REXCVAR_GET(gpu_render_target_transfer_log);
+  if (interval <= 0) {
+    transfer_log_frames_ = 0;
+    transfer_stats_ = {};
+    return;
+  }
+  ++transfer_log_frame_;
+  if (++transfer_log_frames_ < uint32_t(interval)) {
+    return;
+  }
+  const TransferStats& stats = transfer_stats_;
+  double frames = double(transfer_log_frames_);
+  REXGPU_INFO(
+      "Render target transfers (avg per frame over {} frames): {:.1f} draws needing them, {:.1f} "
+      "transfers, {:.1f} dropped and {:.1f} cut by the draw overwriting them, {:.0f} of {:.0f} "
+      "thousand samples copied ({:.0f}%), gpu_render_target_transfer_skip_overwritten {}",
+      transfer_log_frames_, double(stats.updates_with_transfers) / frames,
+      double(stats.transfers) / frames, double(stats.transfers_dropped) / frames,
+      double(stats.transfers_cut) / frames, double(stats.samples_copied) / frames / 1000.0,
+      double(stats.samples_needed) / frames / 1000.0,
+      stats.samples_needed ? 100.0 * double(stats.samples_copied) / double(stats.samples_needed)
+                           : 100.0,
+      REXCVAR_GET(gpu_render_target_transfer_skip_overwritten));
+  transfer_stats_ = {};
+  transfer_log_frames_ = 0;
+  // The next frame's transfers in detail.
+  transfer_log_this_frame_ = true;
+}
+
+void RenderTargetCache::CutOutTransfersOverwrittenByDraw(
+    uint32_t rts_used_bits, RenderTarget* const* rts, reg::RB_DEPTHCONTROL normalized_depth_control,
+    uint32_t normalized_color_mask, const Shader& vertex_shader, const Shader* pixel_shader,
+    bool pixel_shader_known, uint32_t height_used) {
+  uint32_t rts_with_transfers = 0;
+  uint32_t rts_remaining = rts_used_bits;
+  uint32_t rt_index;
+  while (rex::bit_scan_forward(rts_remaining, &rt_index)) {
+    rts_remaining &= ~(uint32_t(1) << rt_index);
+    if (!last_update_transfers_[rt_index].empty()) {
+      rts_with_transfers |= uint32_t(1) << rt_index;
+    }
+  }
+  if (!rts_with_transfers) {
+    return;
+  }
+  const bool skip_enabled = REXCVAR_GET(gpu_render_target_transfer_skip_overwritten);
+  const bool stats_enabled = REXCVAR_GET(gpu_render_target_transfer_log) > 0;
+  if (!skip_enabled && !stats_enabled) {
+    return;
+  }
+  const bool log_draw = stats_enabled && transfer_log_this_frame_;
+  auto describe_render_target = [](RenderTargetKey key) -> std::string {
+    uint32_t pitch_pixels = key.pitch_tiles_at_32bpp *
+                            (xenos::kEdramTileWidthSamples >>
+                             uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X));
+    return fmt::format(
+        "{} {}@{} pitch {} {}x", key.is_depth ? "depth" : "color",
+        key.is_depth ? xenos::GetDepthRenderTargetFormatName(key.GetDepthFormat())
+                     : xenos::GetColorRenderTargetFormatName(key.GetColorFormat()),
+        uint32_t(key.base_tiles), pitch_pixels, uint32_t(1) << uint32_t(key.msaa_samples));
+  };
+
+  const RegisterFile& regs = register_file();
+  const uint32_t sample_count_log2 = uint32_t(regs.Get<reg::RB_SURFACE_INFO>().msaa_samples);
+  auto get_rectangles = [&](uint32_t rt, const Transfer& transfer,
+                            Transfer::Rectangle* rectangles_out,
+                            const Transfer::Rectangle* cutout) -> uint32_t {
+    RenderTargetKey key = rts[rt]->key();
+    return transfer.GetRectangles(key.base_tiles, key.GetPitchTiles(), key.msaa_samples,
+                                  key.Is64bpp(), rectangles_out, cutout);
+  };
+  auto get_samples = [&](uint32_t rt, const Transfer& transfer,
+                         const Transfer::Rectangle* cutout) -> uint64_t {
+    Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithCutout];
+    uint32_t rectangle_count = get_rectangles(rt, transfer, rectangles, cutout);
+    uint64_t pixels = 0;
+    for (uint32_t i = 0; i < rectangle_count; ++i) {
+      pixels += uint64_t(rectangles[i].width_pixels) * rectangles[i].height_pixels;
+    }
+    return pixels << sample_count_log2;
+  };
+
+  // The area needed by all the transfers.
+  DrawExtentEstimator::PixelRect needed = {UINT32_MAX, UINT32_MAX, 0, 0};
+  rts_remaining = rts_with_transfers;
+  while (rex::bit_scan_forward(rts_remaining, &rt_index)) {
+    rts_remaining &= ~(uint32_t(1) << rt_index);
+    for (const Transfer& transfer : last_update_transfers_[rt_index]) {
+      Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithoutCutout];
+      uint32_t rectangle_count = get_rectangles(rt_index, transfer, rectangles, nullptr);
+      for (uint32_t i = 0; i < rectangle_count; ++i) {
+        const Transfer::Rectangle& rectangle = rectangles[i];
+        needed.left = std::min(needed.left, rectangle.x_pixels);
+        needed.top = std::min(needed.top, rectangle.y_pixels);
+        needed.right = std::max(needed.right, rectangle.x_pixels + rectangle.width_pixels);
+        needed.bottom = std::max(needed.bottom, rectangle.y_pixels + rectangle.height_pixels);
+      }
+    }
+  }
+
+  // Whether the draw replaces every sample of a rectangle (the cutout) in all
+  // or some of the render targets.
+  const char* draw_reason = nullptr;
+  const char* rt_reasons[1 + xenos::kMaxColorRenderTargets] = {};
+  uint32_t overwritten_rts = 0;
+  Transfer::Rectangle cutout = {};
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  if (!pixel_shader_known) {
+    draw_reason = "not supported by the backend";
+  } else if (pixel_shader && pixel_shader->kills_pixels()) {
+    draw_reason = "pixel shader discards";
+  } else if (pixel_shader && rb_colorcontrol.alpha_test_enable &&
+             rb_colorcontrol.alpha_func != xenos::CompareFunction::kAlways) {
+    draw_reason = "alpha test";
+  } else if (pixel_shader && rb_colorcontrol.alpha_to_mask_enable) {
+    draw_reason = "alpha to coverage";
+  } else {
+    DrawExtentEstimator::PixelRect needed_in_scissor;
+    needed_in_scissor.left = std::max(needed.left, scissor.offset[0]);
+    needed_in_scissor.top = std::max(needed.top, scissor.offset[1]);
+    needed_in_scissor.right = std::min(needed.right, scissor.offset[0] + scissor.extent[0]);
+    needed_in_scissor.bottom = std::min(needed.bottom, scissor.offset[1] + scissor.extent[1]);
+    DrawExtentEstimator::PixelRect covered;
+    if (needed_in_scissor.right <= needed_in_scissor.left ||
+        needed_in_scissor.bottom <= needed_in_scissor.top) {
+      draw_reason = "scissor outside the area";
+    } else {
+      draw_reason =
+          draw_extent_estimator_.GetDrawFullCoverage(vertex_shader, needed_in_scissor, covered);
+    }
+    if (!draw_reason) {
+      uint32_t left = std::max(covered.left, scissor.offset[0]);
+      uint32_t top = std::max(covered.top, scissor.offset[1]);
+      uint32_t right = std::min(covered.right, scissor.offset[0] + scissor.extent[0]);
+      uint32_t bottom = std::min(covered.bottom, scissor.offset[1] + scissor.extent[1]);
+      if (right <= left || bottom <= top) {
+        draw_reason = "covered area outside the scissor";
+      } else {
+        cutout.x_pixels = left;
+        cutout.y_pixels = top;
+        cutout.width_pixels = right - left;
+        cutout.height_pixels = bottom - top;
+      }
+    }
+  }
+  if (!draw_reason) {
+    bool primitive_polygonal = draw_util::IsPrimitivePolygonal(regs);
+    rts_remaining = rts_with_transfers;
+    while (rex::bit_scan_forward(rts_remaining, &rt_index)) {
+      rts_remaining &= ~(uint32_t(1) << rt_index);
+      const char* reason = nullptr;
+      if (!rt_index) {
+        const reg::RB_DEPTHCONTROL& depth_control = normalized_depth_control;
+        if (!depth_control.z_enable || !depth_control.z_write_enable ||
+            depth_control.zfunc != xenos::CompareFunction::kAlways) {
+          reason = "depth not always replaced";
+        } else if (!depth_control.stencil_enable ||
+                   depth_control.stencilfunc != xenos::CompareFunction::kAlways ||
+                   depth_control.stencilzpass != xenos::StencilOp::kReplace) {
+          reason = "stencil not always replaced";
+        } else if (primitive_polygonal && depth_control.backface_enable &&
+                   (depth_control.stencilfunc_bf != xenos::CompareFunction::kAlways ||
+                    depth_control.stencilzpass_bf != xenos::StencilOp::kReplace)) {
+          reason = "back face stencil not always replaced";
+        } else if (regs.Get<reg::RB_STENCILREFMASK>().stencilwritemask != 0xFF) {
+          // Face culling is excluded, the host uses the front face masks.
+          reason = "stencil write mask";
+        }
+      } else {
+        uint32_t color_index = rt_index - 1;
+        if (((normalized_color_mask >> (4 * color_index)) & 0b1111) != 0b1111) {
+          reason = "color write mask";
+        } else {
+          auto blendcontrol =
+              regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[color_index]);
+          if (blendcontrol.color_srcblend != xenos::BlendFactor::kOne ||
+              blendcontrol.color_destblend != xenos::BlendFactor::kZero ||
+              blendcontrol.color_comb_fcn != xenos::BlendOp::kAdd ||
+              blendcontrol.alpha_srcblend != xenos::BlendFactor::kOne ||
+              blendcontrol.alpha_destblend != xenos::BlendFactor::kZero ||
+              blendcontrol.alpha_comb_fcn != xenos::BlendOp::kAdd) {
+            reason = "blending";
+          }
+        }
+      }
+      if (reason) {
+        rt_reasons[rt_index] = reason;
+      } else {
+        overwritten_rts |= uint32_t(1) << rt_index;
+      }
+    }
+  }
+
+  const bool apply = skip_enabled && overwritten_rts;
+  if (log_draw) {
+    auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+    auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+    REXGPU_INFO(
+        "Render target transfers in frame {}, draw {}: primitive {} x{}, scissor {},{} {}x{}, "
+        "height {}, depth control {:08X} stencil ref/mask {:08X}, color mask {:04X}, blend0 "
+        "{:08X}, color control {:08X}, pixel shader {}, clip {}, cull {}{} - {}",
+        transfer_log_frame_, transfer_log_draw_, uint32_t(vgt_draw_initiator.prim_type),
+        uint32_t(vgt_draw_initiator.num_indices), scissor.offset[0], scissor.offset[1],
+        scissor.extent[0], scissor.extent[1], height_used, normalized_depth_control.value,
+        regs[XE_GPU_REG_RB_STENCILREFMASK], normalized_color_mask,
+        regs[XE_GPU_REG_RB_BLENDCONTROL0], rb_colorcontrol.value,
+        !pixel_shader_known ? "unknown" : (pixel_shader ? "yes" : "none"),
+        regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable ? "off" : "on",
+        uint32_t(pa_su_sc_mode_cntl.cull_front), uint32_t(pa_su_sc_mode_cntl.cull_back),
+        draw_reason ? fmt::format("not overwritten: {}", draw_reason)
+                    : fmt::format("replaces {},{} {}x{}", cutout.x_pixels, cutout.y_pixels,
+                                  cutout.width_pixels, cutout.height_pixels));
+  }
+
+  TransferStats& stats = transfer_stats_;
+  ++stats.updates_with_transfers;
+  rts_remaining = rts_with_transfers;
+  while (rex::bit_scan_forward(rts_remaining, &rt_index)) {
+    rts_remaining &= ~(uint32_t(1) << rt_index);
+    std::vector<Transfer>& transfers = last_update_transfers_[rt_index];
+    const bool rt_overwritten = (overwritten_rts & (uint32_t(1) << rt_index)) != 0;
+    size_t transfers_kept = 0;
+    for (size_t i = 0; i < transfers.size(); ++i) {
+      const Transfer& transfer = transfers[i];
+      uint64_t samples_needed = get_samples(rt_index, transfer, nullptr);
+      uint64_t samples_copied =
+          rt_overwritten ? get_samples(rt_index, transfer, &cutout) : samples_needed;
+      ++stats.transfers;
+      stats.samples_needed += samples_needed;
+      if (log_draw) {
+        RenderTargetKey dest_key = rts[rt_index]->key();
+        uint32_t pitch_tiles = dest_key.GetPitchTiles();
+        uint32_t local_start =
+            (transfer.start_tiles + xenos::kEdramTileCount - dest_key.base_tiles) &
+            (xenos::kEdramTileCount - 1);
+        uint32_t local_end = local_start + (transfer.end_tiles - transfer.start_tiles);
+        std::string outcome;
+        if (!rt_overwritten) {
+          outcome = fmt::format("copied, {}", rt_reasons[rt_index] ? rt_reasons[rt_index]
+                                                                   : draw_reason);
+        } else if (!samples_copied) {
+          outcome = apply ? "skipped" : "would be skipped";
+        } else if (samples_copied < samples_needed) {
+          outcome = fmt::format("{} {}k samples outside", apply ? "cut to" : "would be cut to",
+                                samples_copied / 1000);
+        } else {
+          outcome = "copied, outside the replaced area";
+        }
+        REXGPU_INFO("  {} <- {}{}: tiles {}-{}, rows {}-{}, {}k samples, {}",
+                    describe_render_target(dest_key),
+                    describe_render_target(transfer.source->key()),
+                    transfer.host_depth_source && transfer.host_depth_source != transfer.source
+                        ? fmt::format(" (host depth {})", describe_render_target(
+                                                              transfer.host_depth_source->key()))
+                        : std::string(),
+                    transfer.start_tiles, transfer.end_tiles, local_start / pitch_tiles,
+                    (local_end + pitch_tiles - 1) / pitch_tiles, samples_needed / 1000, outcome);
+      }
+      if (!apply) {
+        stats.samples_copied += samples_needed;
+        transfers_kept = transfers.size();
+        continue;
+      }
+      stats.samples_copied += samples_copied;
+      if (!samples_copied) {
+        ++stats.transfers_dropped;
+        continue;
+      }
+      if (samples_copied < samples_needed) {
+        ++stats.transfers_cut;
+      }
+      if (transfers_kept != i) {
+        transfers[transfers_kept] = transfer;
+      }
+      ++transfers_kept;
+    }
+    if (apply && transfers_kept < transfers.size()) {
+      transfers.erase(transfers.begin() + transfers_kept, transfers.end());
+    }
+  }
+  if (apply) {
+    last_update_transfer_cutout_rts_ = overwritten_rts;
+    last_update_transfer_cutout_ = cutout;
+  }
+}
