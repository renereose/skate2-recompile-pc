+const char* DrawExtentEstimator::GetDrawFullCoverage(const Shader& vertex_shader,
+                                                     const PixelRect& needed_rect,
+                                                     PixelRect& covered_out) {
+  SCOPE_profile_cpu_f("gpu");
+
+  const RegisterFile& regs = register_file_;
+
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (vgt_draw_initiator.source_select != xenos::SourceSelect::kDMA &&
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return "index source";
+  }
+  if (regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+      xenos::VGTOutputPath::kTessellationEnable) {
+    return "tessellation";
+  }
+  xenos::PrimitiveType primitive_type = vgt_draw_initiator.prim_type;
+  uint32_t index_count = vgt_draw_initiator.num_indices;
+  // Triangles as vertex index triplets, in the order the host draws them
+  // (the winding doesn't matter as culling is rejected).
+  static constexpr uint8_t kTriangleListVertices[2][3] = {{0, 1, 2}, {3, 4, 5}};
+  static constexpr uint8_t kTriangleStripVertices[2][3] = {{0, 1, 2}, {1, 3, 2}};
+  static constexpr uint8_t kTriangleFanVertices[2][3] = {{0, 1, 2}, {0, 2, 3}};
+  const uint8_t(*triangle_vertices)[3] = nullptr;
+  uint32_t triangle_count = 0;
+  switch (primitive_type) {
+    case xenos::PrimitiveType::kRectangleList:
+      if (index_count != 3) {
+        return "not one rectangle";
+      }
+      break;
+    case xenos::PrimitiveType::kTriangleList:
+      if (index_count != 3 && index_count != 6) {
+        return "not one or two triangles";
+      }
+      triangle_vertices = kTriangleListVertices;
+      triangle_count = index_count / 3;
+      break;
+    case xenos::PrimitiveType::kTriangleStrip:
+    case xenos::PrimitiveType::kTriangleFan:
+      if (index_count != 3 && index_count != 4) {
+        return "not one or two triangles";
+      }
+      triangle_vertices = primitive_type == xenos::PrimitiveType::kTriangleStrip
+                              ? kTriangleStripVertices
+                              : kTriangleFanVertices;
+      triangle_count = index_count - 2;
+      break;
+    default:
+      return "primitive type";
+  }
+
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (triangle_count) {
+    // Polygonal - faces may be culled, or drawn as wireframe or points.
+    if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back) {
+      return "face culling";
+    }
+    if (pa_su_sc_mode_cntl.poly_mode == xenos::PolygonModeEnable::kDualMode &&
+        (pa_su_sc_mode_cntl.polymode_front_ptype != xenos::PolygonType::kTriangles ||
+         pa_su_sc_mode_cntl.polymode_back_ptype != xenos::PolygonType::kTriangles)) {
+      return "polygon fill mode";
+    }
+  }
+
+  auto pa_cl_clip_cntl = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  if (pa_cl_clip_cntl.ucp_ena) {
+    return "user clip planes";
+  }
+  bool clip_enabled = !pa_cl_clip_cntl.clip_disable;
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (clip_enabled &&
+      (pa_cl_vte_cntl.vtx_xy_fmt || pa_cl_vte_cntl.vtx_z_fmt || pa_cl_vte_cntl.vtx_w0_fmt)) {
+    return "clipped pre-transformed position";
+  }
+  if (!pa_cl_vte_cntl.vtx_xy_fmt && pa_cl_vte_cntl.vtx_w0_fmt) {
+    return "1/W position";
+  }
+
+  assert_true(vertex_shader.type() == xenos::ShaderType::kVertex);
+  assert_true(vertex_shader.is_ucode_analyzed());
+  if (!ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return "vertex shader not interpretable";
+  }
+
+  // The window space transformation as done on the host (see
+  // draw_util::GetHostViewportInfo), with pixel edges at integers.
+  float scale_x =
+      pa_cl_vte_cntl.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  float scale_y =
+      pa_cl_vte_cntl.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  float offset_x =
+      pa_cl_vte_cntl.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  float offset_y =
+      pa_cl_vte_cntl.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+  float offset_add_x = 0.0f, offset_add_y = 0.0f;
+  if (pa_su_sc_mode_cntl.vtx_window_offset_enable) {
+    auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+    offset_add_x += float(pa_sc_window_offset.window_x_offset);
+    offset_add_y += float(pa_sc_window_offset.window_y_offset);
+  }
+  if (REXCVAR_GET(half_pixel_offset) &&
+      regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+    offset_add_x += 0.5f;
+    offset_add_y += 0.5f;
+  }
+
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  const uint16_t* index_buffer_16 = nullptr;
+  const uint32_t* index_buffer_32 = nullptr;
+  xenos::Endian index_endian = vgt_dma_size.swap_mode;
+  if (vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+    if (vgt_dma_size.num_words < index_count) {
+      return "index buffer size";
+    }
+    uint32_t index_buffer_base = regs[XE_GPU_REG_VGT_DMA_BASE];
+    if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16) {
+      if (index_endian == xenos::Endian::k8in32) {
+        index_endian = xenos::Endian::k8in16;
+      } else if (index_endian == xenos::Endian::k16in32) {
+        index_endian = xenos::Endian::kNone;
+      }
+      index_buffer_base &= ~uint32_t(sizeof(uint16_t) - 1);
+      index_buffer_16 = memory_.TranslatePhysical<const uint16_t*>(index_buffer_base);
+    } else {
+      index_buffer_base &= ~uint32_t(sizeof(uint32_t) - 1);
+      index_buffer_32 = memory_.TranslatePhysical<const uint32_t*>(index_buffer_base);
+    }
+    if (trace_writer_) {
+      trace_writer_->WriteMemoryRead(
+          index_buffer_base,
+          (index_buffer_16 ? sizeof(uint16_t) : sizeof(uint32_t)) * size_t(index_count));
+    }
+  }
+  uint32_t reset_index = regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx;
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+
+  // Doubles for exact enough edge tests with coordinates up to 8192.
+  double positions[6][2];
+  const char* failure = nullptr;
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionYExportSink position_export_sink;
+  shader_interpreter_.SetExportSink(&position_export_sink);
+  for (uint32_t i = 0; i < index_count; ++i) {
+    uint32_t vertex_index = i;
+    if (vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+      vertex_index = index_buffer_16 ? uint32_t(index_buffer_16[i]) : index_buffer_32[i];
+      vertex_index = xenos::GpuSwap(vertex_index, index_endian) & 0xFFFFFF;
+      if (pa_su_sc_mode_cntl.multi_prim_ib_ena && vertex_index == reset_index) {
+        failure = "primitive reset";
+        break;
+      }
+    }
+    vertex_index = std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+    position_export_sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if (position_export_sink.vertex_kill().has_value() &&
+        (position_export_sink.vertex_kill().value() & ~(UINT32_C(1) << 31))) {
+      failure = "vertex kill";
+      break;
+    }
+    if (!position_export_sink.position_x().has_value() ||
+        !position_export_sink.position_y().has_value()) {
+      failure = "position not exported";
+      break;
+    }
+    float x = position_export_sink.position_x().value();
+    float y = position_export_sink.position_y().value();
+    if (clip_enabled) {
+      // Must be inside the clip volume, so nothing is clipped.
+      if (!position_export_sink.position_z().has_value() ||
+          !position_export_sink.position_w().has_value()) {
+        failure = "position not exported";
+        break;
+      }
+      float z = position_export_sink.position_z().value();
+      float w = position_export_sink.position_w().value();
+      if (!(w > 0.0f) || !(std::abs(x) <= w) || !(std::abs(y) <= w) || !(z <= w) ||
+          !(z >= (pa_cl_clip_cntl.dx_clip_space_def ? 0.0f : -w))) {
+        failure = "outside the clip volume";
+        break;
+      }
+    }
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      if (!position_export_sink.position_w().has_value()) {
+        failure = "position not exported";
+        break;
+      }
+      float w = position_export_sink.position_w().value();
+      if (!(w > 0.0f) || !std::isfinite(w)) {
+        failure = "position W";
+        break;
+      }
+      x /= w;
+      y /= w;
+    }
+    x = x * scale_x + offset_x + offset_add_x;
+    y = y * scale_y + offset_y + offset_add_y;
+    if (!std::isfinite(x) || !std::isfinite(y)) {
+      failure = "position not finite";
+      break;
+    }
+    positions[i][0] = x;
+    positions[i][1] = y;
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (failure) {
+    return failure;
+  }
+
+  // Bounding box of the vertices.
+  double box_left = positions[0][0], box_top = positions[0][1];
+  double box_right = box_left, box_bottom = box_top;
+  for (uint32_t i = 1; i < index_count; ++i) {
+    box_left = std::min(box_left, positions[i][0]);
+    box_top = std::min(box_top, positions[i][1]);
+    box_right = std::max(box_right, positions[i][0]);
+    box_bottom = std::max(box_bottom, positions[i][1]);
+  }
+  // Corner of the bounding box a vertex is at (bit 0 - right, bit 1 - bottom),
+  // or -1.
+  auto box_corner = [&](uint32_t vertex) -> int32_t {
+    const double* position = positions[vertex];
+    int32_t corner = 0;
+    if (position[0] == box_right) {
+      corner |= 1;
+    } else if (position[0] != box_left) {
+      return -1;
+    }
+    if (position[1] == box_bottom) {
+      corner |= 2;
+    } else if (position[1] != box_top) {
+      return -1;
+    }
+    return corner;
+  };
+  bool is_box = false;
+  if (box_right > box_left && box_bottom > box_top) {
+    if (!triangle_count) {
+      // Rectangle list: three distinct corners of an axis-aligned rectangle
+      // define it - the host computes the fourth one.
+      int32_t corners[3];
+      for (uint32_t i = 0; i < 3; ++i) {
+        corners[i] = box_corner(i);
+      }
+      is_box = corners[0] >= 0 && corners[1] >= 0 && corners[2] >= 0 &&
+               corners[0] != corners[1] && corners[1] != corners[2] && corners[0] != corners[2];
+    } else if (triangle_count == 2) {
+      // Two triangles, each with three distinct corners of the bounding box,
+      // without the opposite corners - the halves of the box on both sides of
+      // the same diagonal.
+      int32_t missing_corners[2];
+      is_box = true;
+      for (uint32_t i = 0; is_box && i < 2; ++i) {
+        uint32_t corner_mask = 0;
+        for (uint32_t j = 0; j < 3; ++j) {
+          int32_t corner = box_corner(triangle_vertices[i][j]);
+          if (corner < 0 || (corner_mask & (uint32_t(1) << corner))) {
+            is_box = false;
+            break;
+          }
+          corner_mask |= uint32_t(1) << corner;
+        }
+        if (is_box) {
+          uint32_t missing_corner;
+          rex::bit_scan_forward(~corner_mask & 0b1111, &missing_corner);
+          missing_corners[i] = int32_t(missing_corner);
+        }
+      }
+      is_box = is_box && (missing_corners[0] ^ missing_corners[1]) == 0b11;
+    }
+  }
+
+  if (is_box) {
+    // Pixels whose samples (at least 1/8 pixel from the edges, or 1/56 with
+    // resolution scaling up to 7x) are all inside, allowing for host rounding.
+    constexpr double kEdgeTolerance = 1.0 / 128.0;
+    auto clamp_edge = [](double edge) -> uint32_t {
+      return uint32_t(std::min(std::max(edge, 0.0), double(xenos::kTexture2DCubeMaxWidthHeight)));
+    };
+    covered_out.left = clamp_edge(std::ceil(box_left - kEdgeTolerance));
+    covered_out.top = clamp_edge(std::ceil(box_top - kEdgeTolerance));
+    covered_out.right = clamp_edge(std::floor(box_right + kEdgeTolerance));
+    covered_out.bottom = clamp_edge(std::floor(box_bottom + kEdgeTolerance));
+    if (covered_out.right <= covered_out.left || covered_out.bottom <= covered_out.top) {
+      return "covers no whole pixel";
+    }
+    return nullptr;
+  }
+  if (!triangle_count) {
+    return "rectangle not axis-aligned";
+  }
+  // One triangle containing the needed rectangle (its corners - it's convex).
+  if (needed_rect.right <= needed_rect.left || needed_rect.bottom <= needed_rect.top) {
+    return "nothing needed";
+  }
+  const double corners[4][2] = {
+      {double(needed_rect.left), double(needed_rect.top)},
+      {double(needed_rect.right), double(needed_rect.top)},
+      {double(needed_rect.left), double(needed_rect.bottom)},
+      {double(needed_rect.right), double(needed_rect.bottom)},
+  };
+  for (uint32_t i = 0; i < triangle_count; ++i) {
+    const double* a = positions[triangle_vertices[i][0]];
+    const double* b = positions[triangle_vertices[i][1]];
+    const double* c = positions[triangle_vertices[i][2]];
+    double area = (b[0] - a[0]) * (c[1] - a[1]) - (c[0] - a[0]) * (b[1] - a[1]);
+    if (!(std::abs(area) > 0.0)) {
+      continue;
+    }
+    bool contains = true;
+    for (uint32_t j = 0; contains && j < 4; ++j) {
+      const double* p = corners[j];
+      double e0 = (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0]);
+      double e1 = (c[0] - b[0]) * (p[1] - b[1]) - (c[1] - b[1]) * (p[0] - b[0]);
+      double e2 = (a[0] - c[0]) * (p[1] - c[1]) - (a[1] - c[1]) * (p[0] - c[0]);
+      contains = area > 0.0 ? (e0 >= 0.0 && e1 >= 0.0 && e2 >= 0.0)
+                            : (e0 <= 0.0 && e1 <= 0.0 && e2 <= 0.0);
+    }
+    if (contains) {
+      covered_out = needed_rect;
+      return nullptr;
+    }
+  }
+  return "triangles don't cover the area";
+}
